# Enables answer synthesis and LLM-judge quality grading.
# Without it the system runs in offline extractive mode — everything except
# generated answers and answer-quality metrics still works.
ANTHROPIC_API_KEY=

# Force the deterministic path even when a key is present (CI uses this).
AIOPS_FORCE_OFFLINE=0

# Models
AIOPS_REASONING_MODEL=claude-opus-5
AIOPS_CHEAP_MODEL=claude-haiku-4-5
AIOPS_EFFORT=medium

# Retrieval
AIOPS_TOP_K=8
AIOPS_DENSE_WEIGHT=0.80
AIOPS_DOC_CHUNK_TOKENS=160

# Guardrails
AIOPS_CONFIDENCE_THRESHOLD=0.55

# OpenTelemetry (optional). Without it spans are buffered in-process.
# AIOPS_OTLP_ENDPOINT=http://localhost:4318/v1/traces
