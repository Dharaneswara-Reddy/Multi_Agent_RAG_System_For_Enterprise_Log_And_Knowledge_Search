# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Generated data — rebuild with `uv run python scripts/setup.py`
data/index/
data/aiops.db
data/docs/
data/logs/*.log
data/logs/external/
data/corpus_manifest.json
data/error_catalog.json
data/eval/latest_report.json
data/eval/sweep.json

# Keep the golden set — it is the contract, not an artifact
!data/eval/golden.jsonl

# Env
.env

# Terraform
#
# State first, and it matters most: a state file records every attribute of
# every resource, including the generated RDS master password in clear text.
# It belongs in the S3 backend, never in git.
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Real variable files carry account ids and CIDRs; the example is the contract.
*.tfvars
*.tfvars.json
!terraform.tfvars.example
# Written out-of-band per infra/README.md — names a bucket, differs per env.
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local agent/editor state
.claude/
